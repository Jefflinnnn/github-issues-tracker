# triage setup asks for these and saves them to ~/.config/triage/.env.
# To set them by hand instead, copy this file to .env and fill it in.
# Git ignores .env; never commit real values. A .env in the current folder
# wins over setup's file, and both win over your shell's environment.

# Read-only GitHub token (see README).
GITHUB_TOKEN=

# Model provider: anthropic, openai or bedrock. Empty uses the first one
# whose key is set below, in that order.
TRIAGE_PROVIDER=
# haiku (default), sonnet or opus for anthropic and bedrock; the model name
# for openai. --model overrides it per run.
TRIAGE_MODEL=

# Anthropic API.
ANTHROPIC_API_KEY=

# OpenAI-compatible endpoint. Empty base URL means OpenAI; a local Ollama
# is http://localhost:11434/v1 and needs no key.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# The model's price in USD per million tokens, input,output; 0,0 for a
# local model. Not needed for gpt-6-luna, gpt-6.1-terra or gpt-6.1-sol on
# OpenAI itself; required for any other openai model or server.
TRIAGE_PRICE_PER_MTOK=

# Amazon Bedrock.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
# Optional: temporary credentials.
AWS_SESSION_TOKEN=
# Optional: your organization's gateway in front of Bedrock. Empty sends
# requests to AWS directly.
BEDROCK_ENDPOINT_URL=

# Optional: where triage keeps its history.
# Default: ~/.local/share/triage/triage.db
TRIAGE_DB=
