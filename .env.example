# Copy to .env and fill in. Git ignores .env; never commit real values.
# Values in .env win over the same names exported in your shell.

# Read-only GitHub token (see README).
GITHUB_TOKEN=

# Model: Claude on Amazon Bedrock.
# haiku (default), sonnet or opus; --model overrides it per run.
TRIAGE_MODEL=haiku
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
# Optional: temporary credentials.
AWS_SESSION_TOKEN=
# Optional: your organization's gateway in front of Bedrock. Empty sends
# requests to AWS directly.
BEDROCK_ENDPOINT_URL=

# Optional: where triage keeps its history.
# Default: ~/.local/share/triage/triage.db
TRIAGE_DB=
